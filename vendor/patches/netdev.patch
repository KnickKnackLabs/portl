+fn interface_index(_addr: &libc::ifaddrs, name: &str) -> u32 {
+    #[cfg(target_vendor = "apple")]
+    {
+        let sa = _addr.ifa_addr;
+        // Darwin's AF_LINK entry already contains the index in this snapshot.
+        // Read only the index field; sockaddr_dl records may be variable-sized.
+        if !sa.is_null()
+            && unsafe { (*sa).sa_family as libc::c_int } == libc::AF_LINK
+            && unsafe { (*sa).sa_len as usize }
+                >= std::mem::offset_of!(libc::sockaddr_dl, sdl_index)
+                    + std::mem::size_of::<u16>()
+        {
+            let sdl = sa.cast::<libc::sockaddr_dl>();
+            let index = unsafe { std::ptr::addr_of!((*sdl).sdl_index).read_unaligned() };
+            if index != 0 {
+                return u32::from(index);
+            }
+        }
+    }
+    // Preserve support for entries without link-layer data and other Unix OSes.
+    if_nametoindex_or_zero(name)
+}
